    /**
     * Test get_template_file_info with null parameter
     */
    public function testGetTemplateFileInfoWithNullParameter()
    {
        $result = $this->apiTemplateStructure->get_template_file_info(null);

        // Should return null for null parameter
        $this->assertNull($result);
    }

    /**
     * Test get_template_file_info with numeric parameter
     */
    public function testGetTemplateFileInfoWithNumericParameter()
    {
        $result = $this->apiTemplateStructure->get_template_file_info(123);

        // Should return null for numeric parameter
        $this->assertNull($result);
    }
    /**
     */
    public function testGetTemplateFileInfoWithArrayParameter()
    {
        $result = $this->apiTemplateStructure->get_template_file_info(['template.html']);

        // Should return info for the .html extension
        $this->assertIsArray($result);
        $this->assertEquals("", $result["name"]);
        $this->assertEquals('webpage', $result['type']);
        $this->assertEquals('.html', $result['extension']);
    }

    /**
     * Test get_template_file_info with extension only (no filename)
     */
    public function testGetTemplateFileInfoWithExtensionOnly()
    {
        $result = $this->apiTemplateStructure->get_template_file_info('.html');

        // Should return info for the .html extension
        $this->assertIsArray($result);
        $this->assertEquals("", $result["name"]);
        $this->assertEquals('webpage', $result['type']);
        $this->assertEquals('.html', $result['extension']);
    }

    /**
     * Test register_template_engine with non-array parameter
     */
    public function testRegisterTemplateEngineWithNonArrayParameter()
    {
        $initialEngines = $this->apiTemplateStructure->get_template_engines();

        $this->apiTemplateStructure->register_template_engine('not_an_array');

        $result = $this->apiTemplateStructure->get_template_engines();

        $this->assertEquals($initialEngines, $result);
    }

    /**
     * Test register_template_engine with nested array
     */
    public function testRegisterTemplateEngineWithNestedArray()
    {
        $engines = [
            'twig' => [
                'name' => 'Twig',
                'version' => '3.0'
            ]
        ];

        $this->apiTemplateStructure->register_template_engine($engines);
        $result = $this->apiTemplateStructure->get_template_engines();

        // Should still register it (array will be treated as string)
        $this->assertArrayHasKey('twig', $result);
    }

    /**
     * Test error accumulation across multiple operations
     */
    public function testErrorAccumulationAcrossMultipleOperations()
    {
        // First operation that should fail
        $this->apiTemplateStructure->create_template_group([]);

        // Second operation that should fail
        $this->apiTemplateStructure->get_group_info('');

        // Third operation that should fail
        $this->apiTemplateStructure->create_template_group(['group_name' => 'act']); // Reserved name

        // Should have accumulated multiple errors
        $this->assertGreaterThanOrEqual(2, $this->apiTemplateStructure->error_count());
    }

    /**
     * Test error state reset between operations
     */
    public function testErrorStateResetBetweenOperations()
    {
        // This should create an error
        $this->apiTemplateStructure->create_template_group([]);

        $errorCount1 = $this->apiTemplateStructure->error_count();

        // This should also create an error
        $this->apiTemplateStructure->create_template_group([]);

        $errorCount2 = $this->apiTemplateStructure->error_count();

        // Error count should accumulate
        $this->assertEquals($errorCount1 * 2, $errorCount2);
    }

    /**
     * Test handling of database connection errors
     */
    public function testHandlingOfDatabaseConnectionErrors()
    {
        // Mock database to throw exception
        $dbMock = $this->createMock('stdClass');
        $dbMock->method('get')->willThrowException(new Exception('Database connection error'));
        ee()->setMock('db', $dbMock);

        $result = $this->apiTemplateStructure->get_group_info(1);

        $this->assertFalse($result);
    }

    /**
     * Test memory usage with large template groups
     */
    public function testMemoryUsageWithLargeTemplateGroups()
    {
        // Create a large number of template groups in mock
        $largeGroups = [];
        for ($i = 1; $i <= 1000; $i++) {
            $largeGroups[$i] = [
                'group_id' => $i,
                'group_name' => 'group_' . $i,
                'site_id' => 1,
                'is_site_default' => 'n',
                'group_order' => $i
            ];
        }

        $this->mockTemplateGroups($largeGroups);

        // Should handle large datasets without memory issues
        $result = $this->apiTemplateStructure->get_group_info(500);

        $this->assertNotFalse($result);
        $this->assertEquals('group_500', $result->row()->group_name);
    }

    /**
     * Test security considerations with file paths
     */
    public function testSecurityConsiderationsWithFilePaths()
    {
        // Test with potentially dangerous paths
        $dangerousPaths = [
            '../../../etc/passwd',
            '..\\..\\..\\windows\\system32',
            '/etc/passwd',
            'C:\\Windows\\System32'
        ];

        foreach ($dangerousPaths as $path) {
            $result = $this->apiTemplateStructure->get_template_file_info($path . '.html');

            // Should still parse correctly but not expose security issues
            $this->assertIsArray($result);
            $this->assertStringNotContainsString('..', $result['name']);
            $this->assertStringNotContainsString('/', $result['name']);
            $this->assertStringNotContainsString('\\', $result['name']);
        }
    }
}
