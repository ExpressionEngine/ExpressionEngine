     * Test file_extensions with empty string template_type
     */
    public function testFileExtensionsWithEmptyStringTemplateType()
    {
        $result = $this->apiTemplateStructure->file_extensions('');

        $this->assertEquals('', $result);
    }

    /**
     * Test file_extensions with numeric template_type
     */
    public function testFileExtensionsWithNumericTemplateType()
    {
        $result = $this->apiTemplateStructure->file_extensions(123);

        $this->assertEquals('', $result);
